NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://itu:itu_dev_password@localhost:5432/itu_scoreboard
# Connection pool
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
DB_SSL=false
# Auth (JWT_SECRET must be >= 32 chars; generate with: openssl rand -base64 48)
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=12h
# Comma-separated list of allowed browser origins (admin + public scoreboard apps)
CORS_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the API (1 on most PaaS / behind nginx)
TRUST_PROXY=0
RATE_LIMIT_PER_MIN=300
LOG_LEVEL=info
# Used by `npm run db:seed` only
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password-now

# Schedule import (npm run import:schedule)
EVENT_DATE=2026-10-10
EVENT_TZ_OFFSET=+05:30
